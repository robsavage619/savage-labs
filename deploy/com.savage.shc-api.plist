<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.savage.shc-api</string>
  <key>UserName</key><string>__USER__</string>
  <key>WorkingDirectory</key><string>__HOME__/Projects/savage-health-center/backend</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/uv</string><string>run</string><string>--no-dev</string><string>--frozen</string>
    <string>uvicorn</string><string>shc.api.main:app</string>
    <string>--host</string><string>127.0.0.1</string><string>--port</string><string>8000</string>
    <string>--log-config</string><string>../logging.yaml</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__HOME__</string>
    <key>TAILSCALE_HOST</key><string>__TSHOST__</string>
    <!-- A boot daemon can't unlock the login Keychain, so on this host every secret
         comes from the backend env file and Keychain lookups return nothing. -->
    <key>PYTHON_KEYRING_BACKEND</key><string>keyring.backends.null.Keyring</string>
    <!-- OAuth tokens rotate on every refresh, so they need a writable store: an owner-only file. -->
    <key>SHC_TOKEN_FILE</key><string>__HOME__/Projects/savage-health-center/backend/data/secrets.json</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/shc-api.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/shc-api.log</string>
</dict>
</plist>
